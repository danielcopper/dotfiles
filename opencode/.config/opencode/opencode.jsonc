{
    "$schema": "https://opencode.ai/config.json",
    "experimental": {
        "todo": true
    },
    // OpenCode 2 allows paths outside the project without asking by default
    "permissions": [
        { "action": "external_directory", "resource": "*", "effect": "ask" }
    ],
    // Hard denies after agent rules and saved approvals; kept in step with permissions.deny in ~/.claude/settings.json
    "policies": [
        { "action": "tool.use", "resource": "read:*/.bashrc.secrets", "effect": "deny" },
        { "action": "tool.use", "resource": "read:*/.ssh/id_*", "effect": "deny" },
        { "action": "tool.use", "resource": "read:*/.ssh/id_*.pub", "effect": "allow" },
        { "action": "tool.use", "resource": "read:*/.gnupg/*", "effect": "deny" },
        { "action": "tool.use", "resource": "read:*/.config/gh/hosts.yml", "effect": "deny" },
        { "action": "tool.use", "resource": "read:*/.claude/.credentials.json", "effect": "deny" },
        { "action": "tool.use", "resource": "read:*/.local/share/opencode/auth.json", "effect": "deny" },
        { "action": "tool.use", "resource": "read:*/.pi/agent/auth.json", "effect": "deny" },
        { "action": "tool.use", "resource": "read:*/.config/memex/ntfy_token", "effect": "deny" },
        { "action": "tool.use", "resource": "read:*/.config/kdeconnect/privateKey.pem", "effect": "deny" },
        { "action": "tool.use", "resource": "read:*/.local/share/uv/credentials/*", "effect": "deny" },
        { "action": "tool.use", "resource": "read:*/.local/share/Trash/*", "effect": "deny" },
        { "action": "tool.use", "resource": "read:*.env", "effect": "deny" },
        { "action": "tool.use", "resource": "read:*.env.local", "effect": "deny" },
        { "action": "tool.use", "resource": "read:*.env.production", "effect": "deny" },
        { "action": "tool.use", "resource": "read:/srv/secrets/*", "effect": "deny" },
        { "action": "tool.use", "resource": "read:/srv/matrix/*", "effect": "deny" },
        { "action": "tool.use", "resource": "read:/mnt/cache/appdata/matrix/*", "effect": "deny" },
        { "action": "tool.use", "resource": "shell:*bashrc.secrets*", "effect": "deny" },
        { "action": "tool.use", "resource": "shell:*/srv/secrets/*", "effect": "deny" },
        { "action": "tool.use", "resource": "shell:*/srv/matrix/*", "effect": "deny" },
        { "action": "tool.use", "resource": "shell:*/mnt/cache/appdata/matrix/*", "effect": "deny" },
        { "action": "tool.use", "resource": "shell:gh pr merge *", "effect": "deny" },
        { "action": "tool.use", "resource": "shell:gh api *pulls/*/merge*", "effect": "deny" },
        { "action": "tool.use", "resource": "shell:gh api *repos/*/merges*", "effect": "deny" },
        { "action": "tool.use", "resource": "shell:*mergePullRequest*", "effect": "deny" },
        { "action": "tool.use", "resource": "shell:*enablePullRequestAutoMerge*", "effect": "deny" },
        { "action": "tool.use", "resource": "shell:*enqueuePullRequest*", "effect": "deny" },
        { "action": "tool.use", "resource": "shell:gh alias set *", "effect": "deny" },
        { "action": "tool.use", "resource": "shell:gh alias import *", "effect": "deny" },
        { "action": "tool.use", "resource": "shell:az repos pr update *--status*completed*", "effect": "deny" },
        { "action": "tool.use", "resource": "shell:az repos pr update *--auto-complete*", "effect": "deny" },
        { "action": "tool.use", "resource": "shell:az repos pr create *--auto-complete*", "effect": "deny" }
    ],
    // ──────────────────────────────────────────────────
    // Agent overrides
    // ──────────────────────────────────────────────────
    "agent": {
        // ── Build agent — restrict destructive operations ──
        "build": {
            "permission": {
                "bash": {
                    "*": "allow",
                    // Destructive file ops — require approval
                    "rm *": "ask",
                    "rm -rf *": "ask",
                    "rmdir *": "ask",
                    "chmod *": "ask",
                    "chown *": "ask",
                    "chgrp *": "ask",
                    "mkfs *": "ask",
                    "dd *": "ask",
                    // Git push — ask for normal, deny force
                    "git push *": "ask",
                    "git push --force*": "deny",
                    "git push -f*": "deny",
                    "git push --force-with-lease*": "ask",
                    // Process/system control — require approval
                    "sudo *": "ask",
                    "kill *": "ask",
                    "killall *": "ask",
                    "pkill *": "ask",
                    "shutdown *": "ask",
                    "reboot *": "ask",
                    "systemctl *": "ask",
                    "service *": "ask",
                    // Remote reach, secrets in the environment, outbound requests
                    "ssh *": "ask",
                    "scp *": "ask",
                    "env *": "ask",
                    "printenv *": "ask",
                    "curl *": "ask",
                    "wget *": "ask",
                    "gh *": "ask",
                    "gh pr view *": "allow",
                    "gh pr list *": "allow",
                    "gh pr diff *": "allow",
                    "gh pr checks *": "allow",
                    "gh issue view *": "allow",
                    "gh issue list *": "allow",
                    "gh run view *": "allow",
                    "gh run list *": "allow",
                    "gh repo view *": "allow",
                    "gh release list *": "allow",
                    "gh release view *": "allow",
                    "gh search *": "allow",
                    // Discards work or publishes
                    "git reset --hard*": "ask",
                    "git clean *": "ask",
                    "git checkout -- *": "ask",
                    "git restore *": "ask",
                    "find * -delete*": "ask",
                    "find * -exec*": "ask",
                    "find * -ok*": "ask",
                    "npm publish *": "ask",
                    "cargo publish *": "ask"
                }
            }
        },
        // ── Supervised agent — everything needs approval ──
        "supervised": {
            "description": "Like Build, but every file change and command requires your approval first.",
            "mode": "primary",
            "tools": {
                "question": true,
                "todoread": true
            },
            "permission": {
                "edit": "ask",
                "write": "ask",
                "bash": {
                    "*": "ask",
                    // Read-only — auto-allow
                    "git status*": "allow",
                    "git log*": "allow",
                    "git diff*": "allow",
                    "git branch*": "allow",
                    "grep *": "allow",
                    "find *": "allow",
                    "find * -delete*": "ask",
                    "find * -exec*": "ask",
                    "find * -ok*": "ask",
                    "cat *": "allow",
                    "head *": "allow",
                    "tail *": "allow",
                    "ls *": "allow",
                    "echo *": "allow",
                    "pwd": "allow",
                    "which *": "allow",
                    "wc *": "allow",
                    "diff *": "allow",
                    "xargs *": "allow",
                    "sort *": "allow",
                    "uniq *": "allow",
                    "cut *": "allow",
                    "tr *": "allow",
                    "awk *": "allow",
                    "sed *": "allow",
                    "tee *": "allow",
                    "less *": "allow",
                    "file *": "allow",
                    "tree *": "allow",
                    "realpath *": "allow",
                    "dirname *": "allow",
                    "basename *": "allow",
                    // Dangerous — explicit deny/ask
                    "rm *": "ask",
                    "rm -rf *": "ask",
                    "rmdir *": "ask",
                    "chmod *": "ask",
                    "chown *": "ask",
                    "chgrp *": "ask",
                    "mkfs *": "ask",
                    "dd *": "ask",
                    "sudo *": "ask",
                    "kill *": "ask",
                    "killall *": "ask",
                    "pkill *": "ask",
                    "shutdown *": "ask",
                    "reboot *": "ask",
                    "systemctl *": "ask",
                    "service *": "ask",
                    "git push --force*": "deny"
                }
            }
        }
    }
}
