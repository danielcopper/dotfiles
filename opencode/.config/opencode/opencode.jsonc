{
    "$schema": "https://opencode.ai/config.json",
    // ──────────────────────────────────────────────────
    // Agent overrides
    // ──────────────────────────────────────────────────
    "agent": {
        // ── Build agent — restrict destructive operations ──
        "build": {
            "permission": {
                "bash": {
                    "*": "allow",
                    // Destructive file ops — require approval
                    "rm *": "ask",
                    "rm -rf *": "ask",
                    "rmdir *": "ask",
                    "chmod *": "ask",
                    "chown *": "ask",
                    "chgrp *": "ask",
                    "mkfs *": "ask",
                    "dd *": "ask",
                    // Git push — ask for normal, deny force
                    "git push *": "ask",
                    "git push --force*": "deny",
                    "git push -f*": "deny",
                    "git push --force-with-lease*": "ask",
                    // Process/system control — require approval
                    "sudo *": "ask",
                    "kill *": "ask",
                    "killall *": "ask",
                    "pkill *": "ask",
                    "shutdown *": "ask",
                    "reboot *": "ask",
                    "systemctl *": "ask",
                    "service *": "ask"
                }
            }
        },
        // ── Supervised agent — everything needs approval ──
        "supervised": {
            "description": "Like Build, but every file change and command requires your approval first.",
            "mode": "primary",
            "tools": {
                "question": true,
                "todoread": true
            },
            "permission": {
                "edit": "ask",
                "write": "ask",
                "bash": {
                    "*": "ask",
                    // Read-only — auto-allow
                    "git status*": "allow",
                    "git log*": "allow",
                    "git diff*": "allow",
                    "git branch*": "allow",
                    "grep *": "allow",
                    "find *": "allow",
                    "cat *": "allow",
                    "head *": "allow",
                    "tail *": "allow",
                    "ls *": "allow",
                    "echo *": "allow",
                    "pwd": "allow",
                    "which *": "allow",
                    "wc *": "allow",
                    "diff *": "allow",
                    "xargs *": "allow",
                    "sort *": "allow",
                    "uniq *": "allow",
                    "cut *": "allow",
                    "tr *": "allow",
                    "awk *": "allow",
                    "sed *": "allow",
                    "tee *": "allow",
                    "less *": "allow",
                    "file *": "allow",
                    "tree *": "allow",
                    "realpath *": "allow",
                    "dirname *": "allow",
                    "basename *": "allow",
                    // Dangerous — explicit deny/ask
                    "rm *": "ask",
                    "rm -rf *": "ask",
                    "rmdir *": "ask",
                    "chmod *": "ask",
                    "chown *": "ask",
                    "chgrp *": "ask",
                    "mkfs *": "ask",
                    "dd *": "ask",
                    "sudo *": "ask",
                    "kill *": "ask",
                    "killall *": "ask",
                    "pkill *": "ask",
                    "shutdown *": "ask",
                    "reboot *": "ask",
                    "systemctl *": "ask",
                    "service *": "ask",
                    "git push --force*": "deny"
                }
            }
        }
    }
}
