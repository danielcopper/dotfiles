# Every Claude Code session on this Deck runs in this slice (the `claude`
# function in .bashrc.local starts it here), and so does everything a session
# starts: agents, mise tasks, pytest and vitest workers. The limits keep the
# desktop and Steam responsive when several sessions test at once: 8 threads
# and 14 GB of RAM are shared with them.
[Unit]
Description=Claude Code sessions and everything they start

[Slice]
# A weight, not a quota: it only matters when the CPU is contended, and then
# Steam and Plasma (app.slice, session.slice, weight 100) win 2:1 over this
# slice. On an otherwise idle machine the slice may use all 8 threads. A
# CPUQuota would cap it even then and throttle it in bursts, which unsettles
# tests with timeouts. A lower weight would leave a test run beside a busy
# Steam too little to finish inside its timeouts.
CPUWeight=50
# Above MemoryHigh the slice is throttled and reclaimed, so it slows down
# instead of starving the rest of the machine. There is deliberately no
# MemoryMax: that limit kills a process inside the slice, a test run or a
# whole session, where waiting is the better outcome.
MemoryHigh=10G
