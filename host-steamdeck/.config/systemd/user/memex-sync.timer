# Runs memex-sync every 2 minutes, which also brings in what other devices
# pushed; memex-watch.service starts it sooner after a change in the clone.
# Persistent= makes up for a run missed while the Deck was asleep or off,
# right after it wakes. Nothing runs at shutdown: what changed since the last
# run waits for the next boot.
# Enabled by hand once the clone exists: systemctl --user enable --now memex-sync.timer
[Unit]
Description=Sync the memex clone every 2 minutes

[Timer]
OnCalendar=*:0/2
Persistent=true

[Install]
WantedBy=timers.target
