# Steamdeck-specific bash config. Sourced by shared .bashrc.

# Clear the prompt hooks SteamOS installs, before mise and starship add theirs.
# In a login shell (every tmux pane, wezterm's `bash -l`) systemd's
# /etc/profile.d/80-systemd-osc-context.sh turns PROMPT_COMMAND into an array,
# and /etc/bash.bashrc's __holo_prompt_command ends up in an element after
# starship's, so it overwrites starship's PS1 with "(deck@steamdeck ~)$" on
# every prompt. PS0 carries systemd's matching per-command hook.
unset PROMPT_COMMAND PS0

# SSH agent socket fallback for nested non-login shells
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"

# Homebrew (linuxbrew on steamdeck because pacman is read-only).
# Bootstrap installs brew before stowing. Only run shellenv if brew's
# bin path isn't already in $PATH — otherwise re-sourcing this file
# duplicates PATH entries on every load.
case ":$PATH:" in
  *":/home/linuxbrew/.linuxbrew/bin:"*) ;;
  *)
    [ -x /home/linuxbrew/.linuxbrew/bin/brew ] && \
      eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    ;;
esac

# Drive brew's internal git operations with the system git rather than
# brew's own. brew ships bottles whose glibc requirement can outrun the
# bundled brew glibc (e.g. git 2.55 needs GLIBC_2.38 while brew glibc was
# still 2.35). When that happens brew's git breaks, and since brew needs
# git to run `brew update`, it can't self-heal — a deadlock. Pointing
# HOMEBREW_GIT_PATH at the stable system git lets `brew update`/`upgrade`
# always run and pull the newer glibc that repairs brew's git.
[ -x /usr/bin/git ] && export HOMEBREW_GIT_PATH=/usr/bin/git

# Nix daemon
if [ -e '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh' ]; then
    . '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh'
fi

# Update wrapper — SteamOS root is read-only, so brew + flatpak stand in
# for the pacman/paru combo on the arch hosts.
alias update='brew update && brew upgrade && flatpak update --user -y'

# Start Claude Code inside claude.slice (~/.config/systemd/user/claude.slice),
# which caps the CPU and memory of a session and everything it starts.
# systemd-run execs the binary in place, so the process is still `claude` for
# tmux's tab names and resurrect.
# CLAUDE_CODE_TMPDIR moves each session's scratchpad and task output from /tmp
# to /var/tmp: /tmp is a tmpfs on SteamOS, so whatever sessions left there held
# RAM and swap until the next reboot. ~/.config/user-tmpfiles.d/claude.conf
# ages out what lands in /var/tmp/claude-<uid> after 30 days.
claude() {
    CLAUDE_CODE_TMPDIR=/var/tmp \
        systemd-run --user --scope --quiet --slice=claude.slice -- claude "$@"
}
