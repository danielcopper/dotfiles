#!/usr/bin/env bash
# Commit, rebase and push the memex clone. memex-sync.timer runs this every
# 15 minutes; setup steps are in the README, section "memex sync on the
# Steam Deck".
#
# - A rebase, merge, cherry-pick or revert left in progress in the clone, or
#   unmerged files, stop the run before it touches anything: exit 1.
# - Every change in the clone is committed as "sync(deck): N Dateien". The
#   author is whatever user.name/user.email the clone's own config sets.
# - Away from home the fetch fails: the run logs why, exits 0 and the commits
#   wait. A fetch that origin refuses (authentication, repository not found)
#   exits 1.
# - Local commits are rebased onto origin/main and pushed. A push that lost a
#   race (origin moved since the fetch) exits 0; the next run tries again.
#   A push that is refused for any other reason, such as the pre-push secret
#   scan, exits 1.
# - A rebase that conflicts is aborted, which leaves the clone as it was. Its
#   HEAD goes to the branch conflict/deck-<date> on origin and the run exits 1.
#   Later runs keep that branch current until a sync gets through.
# - A rebase that git refuses to start, typically because something wrote
#   into the clone after this run's commit, is no conflict: the run logs git's
#   reason and exits 0, and the next run commits that change and tries again.
#
# Unfinished work, a refused fetch or push, and a conflict each send one ntfy
# notification; it is not sent again until a sync gets through. Any other
# failure (no clone, a commit that git refuses, a rebase that cannot be
# aborted) ends the run with a non-zero exit and only a message in the
# journal. The notification needs ~/.config/memex/ntfy_url (the full topic
# URL) and ~/.config/memex/ntfy_token; when either file is missing, none is
# sent. MEMEX_DIR overrides the clone (default ~/memex).
set -euo pipefail

repo=${MEMEX_DIR:-$HOME/memex}
config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/memex
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/memex-sync
# One marker per kind of failure, present while it is unresolved and already
# notified. The conflict marker holds the name of the conflict branch.
busy_marker=$state_dir/operation-in-progress
fetch_marker=$state_dir/fetch-refused
conflict_marker=$state_dir/conflict
refused_marker=$state_dir/push-refused
lock=${XDG_RUNTIME_DIR:-/tmp}/memex-sync.lock
net_timeout=30

export GIT_TERMINAL_PROMPT=0
# An empty GIT_ASKPASS keeps git from falling back to SSH_ASKPASS, which the
# user manager sets to a desktop dialog, when origin asks for credentials.
export GIT_ASKPASS=
# A rebase never stops to ask for a message.
export GIT_EDITOR=true

log() { printf 'memex-sync: %s\n' "$*"; }
# Joins the non-empty lines of git's messages into one log line.
one_line() { awk 'NF { printf "%s%s", sep, $0; sep = " / " }'; }

if [ "$(git -C "$repo" rev-parse --is-inside-work-tree 2>/dev/null)" != true ]; then
  log "$repo is not a git work tree" >&2
  exit 1
fi
cd "$repo"

exec 9>"$lock"
if ! flock --nonblock 9; then
  log "another run holds $lock; skipping"
  exit 0
fi

has_origin_main() { git rev-parse --verify --quiet refs/remotes/origin/main >/dev/null; }

commits_ahead() {
  if has_origin_main; then
    git rev-list --count origin/main..HEAD
  else
    git rev-list --count HEAD
  fi
}

notify() { # notify <title> <message>
  local url token
  [ -r "$config_dir/ntfy_url" ] && [ -r "$config_dir/ntfy_token" ] || return 0
  url=$(<"$config_dir/ntfy_url")
  token=$(<"$config_dir/ntfy_token")
  # The header goes through a file descriptor, so the token never shows up in
  # the process list. ntfy reads a bare token only as a Bearer header.
  if curl --silent --show-error --fail --max-time 15 \
    --header @<(printf 'Authorization: Bearer %s\n' "$token") \
    --header "Title: $1" \
    --data "$2" \
    "$url" >/dev/null; then
    log "notification sent"
  else
    log "notification failed"
  fi
}

notify_once() { # notify_once <marker> <title> <message>
  [ ! -e "$1" ] || return 0
  mkdir -p "$state_dir"
  : >"$1"
  notify "$2" "$3"
}

# Prints what was left unfinished in the clone, if anything.
unfinished_work() {
  local path what
  for path in rebase-merge:rebase rebase-apply:rebase MERGE_HEAD:merge \
    CHERRY_PICK_HEAD:cherry-pick REVERT_HEAD:revert; do
    what=${path#*:}
    path=${path%%:*}
    if [ -e "$(git rev-parse --git-path "$path")" ]; then
      printf 'a %s in progress (%s)\n' "$what" "$path"
      return 0
    fi
  done
  if [ -n "$(git ls-files --unmerged)" ]; then
    printf 'unmerged files\n'
    return 0
  fi
  return 1
}

# Fetches origin. On failure, fetch_error holds git's messages on one line.
fetch_origin() {
  local status=0
  fetch_error=$(timeout "$net_timeout" git fetch --quiet origin 2>&1 >/dev/null) || status=$?
  [ "$status" -ne 0 ] || return 0
  if [ "$status" -eq 124 ]; then
    fetch_error="timed out after $net_timeout s"
  else
    fetch_error=$(one_line <<<"$fetch_error")
  fi
  return 1
}

# Origin answered, but refused us: wrong credentials, no access, no such
# repository. Waiting does not fix that, unlike a network that is not there.
fetch_refused() {
  grep -qiE "Authentication failed|could not read (Username|Password)|returned error: (401|403|404)|repository '.*' not found|Permission denied \(publickey" <<<"$fetch_error"
}

# A refused push is reported once, until a push gets through.
report_refused() { # report_refused <ref>
  log "push to $1 was refused" >&2
  notify_once "$refused_marker" "memex-sync (Deck): push refused" \
    "The Deck's push to $1 was refused. Check journalctl --user -u memex-sync."
  exit 1
}

on_conflict() {
  local branch
  if [ -s "$conflict_marker" ]; then
    branch=$(<"$conflict_marker")
  else
    branch=conflict/deck-$(date +%F)
  fi
  log "rebase onto origin/main failed"
  timeout "$net_timeout" git push --quiet --force origin "HEAD:refs/heads/$branch" ||
    report_refused "$branch"
  rm -f "$refused_marker"
  log "local HEAD is on $branch"
  notify_once "$conflict_marker" "memex-sync (Deck): conflict" \
    "The Deck could not rebase onto origin/main. Its state is on the branch $branch."
  printf '%s\n' "$branch" >"$conflict_marker"
  exit 1
}

# A push that lost a race is retried by the next run; any other refusal is
# reported. Which one it was shows in a fresh fetch: after a race, origin/main
# holds commits that HEAD does not.
on_push_failure() {
  if ! fetch_origin; then
    log "push to origin/main failed and the fetch after it too ($fetch_error); the next run tries again"
    exit 0
  fi
  if has_origin_main && ! git merge-base --is-ancestor origin/main HEAD; then
    log "push to origin/main lost a race; the next run tries again"
    exit 0
  fi
  report_refused main
}

if unfinished=$(unfinished_work); then
  log "found $unfinished in $repo; nothing done" >&2
  notify_once "$busy_marker" "memex-sync (Deck): git operation in progress" \
    "memex-sync found $unfinished in $repo and leaves it alone until that is finished or aborted."
  exit 1
fi

git add --all
staged=$(git diff --cached --name-only --no-renames -z | tr -cd '\0' | wc -c)
if [ "$staged" -gt 0 ]; then
  git commit --quiet --message "sync(deck): $staged Dateien"
  log "committed $staged Dateien"
fi

if ! fetch_origin; then
  if fetch_refused; then
    log "origin refused the fetch: $fetch_error" >&2
    notify_once "$fetch_marker" "memex-sync (Deck): fetch refused" \
      "Origin refused the Deck's fetch: $fetch_error. Check journalctl --user -u memex-sync."
    exit 1
  fi
  log "offline, $(commits_ahead) commits ahead ($fetch_error)"
  exit 0
fi

rebase_in_progress() {
  [ -d "$(git rev-parse --git-path rebase-merge)" ] ||
    [ -d "$(git rev-parse --git-path rebase-apply)" ]
}

# Nothing to rebase onto when origin has no main yet (a fresh repo), and
# nothing to rebase when HEAD already contains origin/main.
if has_origin_main && ! git merge-base --is-ancestor origin/main HEAD; then
  if ! rebase_output=$(git rebase --quiet origin/main 2>&1); then
    # A rebase that never started is no conflict: git refused it, most often
    # because the working tree changed after this run's commit.
    if ! rebase_in_progress; then
      log "working tree changed during the run; the next run retries ($(one_line <<<"$rebase_output"))"
      exit 0
    fi
    printf '%s\n' "$rebase_output"
    # This rebase is this run's own: one that was already in progress
    # stopped the run before the commit.
    git rebase --abort
    on_conflict
  fi
fi

ahead=$(commits_ahead)
if [ "$ahead" -gt 0 ]; then
  timeout "$net_timeout" git push --quiet origin HEAD:main || on_push_failure
  log "pushed $ahead commits"
fi
rm -f "$busy_marker" "$fetch_marker" "$conflict_marker" "$refused_marker"
