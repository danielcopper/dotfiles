#!/usr/bin/env bash
# Commit, rebase and push the memex clone. memex-sync.timer runs this at
# regular times, and memex-watch.service after changes in the clone; setup
# steps are in the README, section "memex sync on the Steam Deck".
#
# - A rebase, merge, cherry-pick or revert left in progress in the clone, or
#   unmerged files, stop the run before it stages or commits anything: exit 1.
# - Every change in the clone is committed in one commit. One file gives
#   "deck: <action> <path>", e.g.
#   "deck: update daniel/memory/global/MEMORY.md"; several give
#   "deck: N files in <dir>", <dir> the deepest directory that holds them all
#   (left out when there is none), and one line "<action> <path>" per file in
#   the body. The action is create, update or delete; a rename is a delete
#   and a create, two files. The author is whatever user.name/user.email the
#   clone's own config sets.
# - Away from home the fetch fails: the run logs why, exits 0 and the commits
#   wait. A fetch that origin refuses (authentication, repository not found)
#   exits 1.
# - Local commits are rebased onto origin/main in a worktree of their own
#   outside the clone ($XDG_RUNTIME_DIR/memex-sync-rebase), and the clone is
#   moved to the result with git reset --keep, which keeps what was written
#   into it after this run's commit. Then the run pushes. A push that lost a
#   race (origin moved since the fetch) exits 0; the next run tries again.
#   A push that is refused for any other reason, such as the pre-push secret
#   scan, exits 1.
# - A rebase that conflicts leaves the clone's work tree untouched: nothing
#   outside its .git/ is written. Its HEAD goes to the branch
#   conflict/deck-<date> on origin and the run exits 1. Later runs keep that
#   branch current until a sync gets through.
# - The clone stays where it is when the move would overwrite something
#   written into it after this run's commit (git refuses it), or would drop a
#   commit made in it during the rebase. The run logs why and exits 0; the
#   next run commits what is new and tries again.
#
# Resolving a conflict by hand, in the clone:
# 1. systemctl --user stop memex-sync.timer memex-watch.service, so no run
#    commits into the work below, and wait until systemctl --user is-active
#    memex-sync.service says inactive: a run already going is left to finish.
# 2. git fetch origin && git rebase --autostash origin/main, and resolve each
#    conflicting file (in MEMORY.md, say, keep both lines, in the right
#    order), git add it, git rebase --continue. When the stashed changes do
#    not apply cleanly at the end, git keeps them in the stash: resolve those
#    files too, then git stash drop.
# 3. git push origin HEAD:main.
# 4. systemctl --user start memex-sync.timer memex-watch.service. The next run
#    finds nothing to rebase, gets through and removes the conflict marker,
#    so the next conflict notifies again.
# 5. The conflict branch stays on origin: git push origin --delete
#    conflict/deck-<date>.
#
# Unfinished work, a refused fetch or push, and a conflict each send one ntfy
# notification; it is not sent again until a sync gets through. Any other
# failure (no clone, a commit that git refuses, a worktree that cannot be
# added) ends the run with a non-zero exit and only a message in the
# journal. The notification needs ~/.config/memex/ntfy_url (the full topic
# URL) and ~/.config/memex/ntfy_token; when either file is missing, none is
# sent. MEMEX_DIR overrides the clone (default ~/memex).
set -euo pipefail

repo=${MEMEX_DIR:-$HOME/memex}
config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/memex
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/memex-sync
# One marker per kind of failure, present while it is unresolved and already
# notified. The conflict marker holds the name of the conflict branch.
busy_marker=$state_dir/operation-in-progress
fetch_marker=$state_dir/fetch-refused
conflict_marker=$state_dir/conflict
refused_marker=$state_dir/push-refused
lock=${XDG_RUNTIME_DIR:-/tmp}/memex-sync.lock
net_timeout=30

export GIT_TERMINAL_PROMPT=0
# An empty GIT_ASKPASS keeps git from falling back to SSH_ASKPASS, which the
# user manager sets to a desktop dialog, when origin asks for credentials.
export GIT_ASKPASS=
# A rebase never stops to ask for a message.
export GIT_EDITOR=true

log() { printf 'memex-sync: %s\n' "$*"; }
# Joins the non-empty lines of git's messages into one log line.
one_line() { awk 'NF { printf "%s%s", sep, $0; sep = " / " }'; }

if [ "$(git -C "$repo" rev-parse --is-inside-work-tree 2>/dev/null)" != true ]; then
  log "$repo is not a git work tree" >&2
  exit 1
fi
cd "$repo"

exec 9>"$lock"
if ! flock --nonblock 9; then
  log "another run holds $lock; skipping"
  exit 0
fi

has_origin_main() { git rev-parse --verify --quiet refs/remotes/origin/main >/dev/null; }

commits_ahead() {
  if has_origin_main; then
    git rev-list --count origin/main..HEAD
  else
    git rev-list --count HEAD
  fi
}

notify() { # notify <title> <message>
  local url token
  [ -r "$config_dir/ntfy_url" ] && [ -r "$config_dir/ntfy_token" ] || return 0
  url=$(<"$config_dir/ntfy_url")
  token=$(<"$config_dir/ntfy_token")
  # The header goes through a file descriptor, so the token never shows up in
  # the process list. ntfy reads a bare token only as a Bearer header.
  if curl --silent --show-error --fail --max-time 15 \
    --header @<(printf 'Authorization: Bearer %s\n' "$token") \
    --header "Title: $1" \
    --data "$2" \
    "$url" >/dev/null; then
    log "notification sent"
  else
    log "notification failed"
  fi
}

notify_once() { # notify_once <marker> <title> <message>
  [ ! -e "$1" ] || return 0
  mkdir -p "$state_dir"
  : >"$1"
  notify "$2" "$3"
}

# Prints what was left unfinished in the clone, if anything.
unfinished_work() {
  local path what
  for path in rebase-merge:rebase rebase-apply:rebase MERGE_HEAD:merge \
    CHERRY_PICK_HEAD:cherry-pick REVERT_HEAD:revert; do
    what=${path#*:}
    path=${path%%:*}
    if [ -e "$(git rev-parse --git-path "$path")" ]; then
      printf 'a %s in progress (%s)\n' "$what" "$path"
      return 0
    fi
  done
  if [ -n "$(git ls-files --unmerged)" ]; then
    printf 'unmerged files\n'
    return 0
  fi
  return 1
}

# Fetches origin. On failure, fetch_error holds git's messages on one line.
fetch_origin() {
  local status=0
  fetch_error=$(timeout "$net_timeout" git fetch --quiet origin 2>&1 >/dev/null) || status=$?
  [ "$status" -ne 0 ] || return 0
  if [ "$status" -eq 124 ]; then
    fetch_error="timed out after $net_timeout s"
  else
    fetch_error=$(one_line <<<"$fetch_error")
  fi
  return 1
}

# Origin answered, but refused us: wrong credentials, no access, no such
# repository. Waiting does not fix that, unlike a network that is not there.
fetch_refused() {
  grep -qiE "Authentication failed|could not read (Username|Password)|returned error: (401|403|404)|repository '.*' not found|Permission denied \(publickey" <<<"$fetch_error"
}

# A refused push is reported once, until a push gets through.
report_refused() { # report_refused <ref>
  log "push to $1 was refused" >&2
  notify_once "$refused_marker" "memex-sync (Deck): push refused" \
    "The Deck's push to $1 was refused. Check journalctl --user -u memex-sync."
  exit 1
}

on_conflict() {
  local branch
  if [ -s "$conflict_marker" ]; then
    branch=$(<"$conflict_marker")
  else
    branch=conflict/deck-$(date +%F)
  fi
  log "rebase onto origin/main failed"
  timeout "$net_timeout" git push --quiet --force origin "HEAD:refs/heads/$branch" ||
    report_refused "$branch"
  rm -f "$refused_marker"
  log "local HEAD is on $branch"
  notify_once "$conflict_marker" "memex-sync (Deck): conflict" \
    "The Deck could not rebase onto origin/main. Its state is on the branch $branch."
  printf '%s\n' "$branch" >"$conflict_marker"
  exit 1
}

# A push that lost a race is retried by the next run; any other refusal is
# reported. Which one it was shows in a fresh fetch: after a race, origin/main
# holds commits that HEAD does not.
on_push_failure() {
  if ! fetch_origin; then
    log "push to origin/main failed and the fetch after it too ($fetch_error); the next run tries again"
    exit 0
  fi
  if has_origin_main && ! git merge-base --is-ancestor origin/main HEAD; then
    log "push to origin/main lost a race; the next run tries again"
    exit 0
  fi
  report_refused main
}

# Prints the commit message for the staged changes in $changes, in the form
# the header describes.
commit_message() {
  local i path dir common='' lines=()
  for ((i = 0; i < ${#changes[@]}; i += 2)); do
    path=${changes[i + 1]}
    case ${changes[i]} in
      A) lines+=("create $path") ;;
      D) lines+=("delete $path") ;;
      *) lines+=("update $path") ;;
    esac
    dir=
    [[ $path != */* ]] || dir=${path%/*}
    if [ "$i" -eq 0 ]; then
      common=$dir
    fi
    while [ -n "$common" ] && [ "$dir" != "$common" ] && [[ $dir != "$common"/* ]]; do
      if [[ $common == */* ]]; then common=${common%/*}; else common=; fi
    done
  done
  if [ "${#lines[@]}" -eq 1 ]; then
    printf 'deck: %s\n' "${lines[0]}"
    return
  fi
  printf 'deck: %s files%s\n\n' "${#lines[@]}" "${common:+ in $common}"
  printf '%s\n' "${lines[@]}"
}

# The fetch comes before the commit, so the network wait does not lie
# between the commit and the move to the rebased commits: a write into the
# clone in that window can make git refuse the move. Its outcome is acted on
# after the commit, so local commits pile up whether origin answers or not.
fetched=true
fetch_origin || fetched=false

# Checked after the fetch, right before the commit: an operation started
# while the fetch waited on the network is caught too.
if unfinished=$(unfinished_work); then
  log "found $unfinished in $repo; nothing done" >&2
  notify_once "$busy_marker" "memex-sync (Deck): git operation in progress" \
    "memex-sync found $unfinished in $repo and leaves it alone until that is finished or aborted."
  exit 1
fi

git add --all
# Status and path of each staged file, in turn; without rename detection a
# rename is a deletion and a creation.
mapfile -d '' -t changes < <(git diff --cached --name-status --no-renames -z)
wait $!
staged=$((${#changes[@]} / 2))
if [ "$staged" -gt 0 ]; then
  # --no-verify skips the global commit hooks. The message is made of file
  # paths, which the commit-msg hook's AI-attribution guard can take for an
  # attribution (daniel/wiki/ai/claude-written-summaries.md, say) and would
  # then refuse on every run; the pre-commit hook only guards main, which the
  # clone may commit on anyway. The push still runs the pre-push hook.
  commit_message | git commit --quiet --no-verify --file=-
  log "committed $staged files"
fi

if [ "$fetched" = false ]; then
  if fetch_refused; then
    log "origin refused the fetch: $fetch_error" >&2
    notify_once "$fetch_marker" "memex-sync (Deck): fetch refused" \
      "Origin refused the Deck's fetch: $fetch_error. Check journalctl --user -u memex-sync."
    exit 1
  fi
  log "offline, $(commits_ahead) commits ahead ($fetch_error)"
  exit 0
fi

# The rebase runs in a worktree of its own outside the clone, so a conflict
# writes nothing outside the clone's .git/, and nothing there looks like a
# change to memex-watch. A run killed during the rebase leaves that worktree
# behind; the next rebase removes it first.
rebase_tree=${XDG_RUNTIME_DIR:-/tmp}/memex-sync-rebase
remove_rebase_tree() {
  rm -rf "$rebase_tree"
  git worktree prune
}

# Nothing to rebase onto when origin has no main yet (a fresh repo), and
# nothing to rebase when HEAD already contains origin/main.
if has_origin_main && ! git merge-base --is-ancestor origin/main HEAD; then
  head=$(git rev-parse HEAD)
  remove_rebase_tree
  trap remove_rebase_tree EXIT
  git worktree add --quiet --detach "$rebase_tree" HEAD
  if ! rebase_output=$(cd "$rebase_tree" && git rebase --quiet origin/main 2>&1); then
    printf '%s\n' "$rebase_output"
    on_conflict
  fi
  rebased=$(git -C "$rebase_tree" rev-parse HEAD)
  # The move below would drop a commit made in the clone during the rebase.
  # The check and the move are two steps: a commit made in the milliseconds
  # between them is still dropped from main and stays only in the reflog.
  if [ "$(git rev-parse HEAD)" != "$head" ]; then
    log "HEAD moved during the run; the next run retries"
    exit 0
  fi
  # --keep moves the clone to the rebased commits and keeps what was written
  # into it after this run's commit; it refuses when the move would
  # overwrite such a write.
  if ! reset_output=$(git reset --quiet --keep "$rebased" 2>&1); then
    log "working tree changed during the run; the next run retries ($(one_line <<<"$reset_output"))"
    exit 0
  fi
fi

ahead=$(commits_ahead)
if [ "$ahead" -gt 0 ]; then
  timeout "$net_timeout" git push --quiet origin HEAD:main || on_push_failure
  log "pushed $ahead commits"
fi
rm -f "$busy_marker" "$fetch_marker" "$conflict_marker" "$refused_marker"
