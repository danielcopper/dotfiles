#!/usr/bin/env bash
# Start memex-sync.service once the memex clone has been quiet for 30 seconds
# after a change: every further change starts the wait again.
# memex-watch.service runs this; setup steps are in the README, section
# "memex sync on the Steam Deck".
#
# Changes under .git/ and .obsidian/, at any depth, do not count: the first
# are git's own, among them every commit of the sync, the second Obsidian's
# settings and workspace, which the clone's .gitignore keeps out of git. A
# pull by the sync changes files and so starts one more run, which finds
# nothing to commit. When a sync started earlier is still running 30 seconds
# after a change, on a slow network say, systemd merges the new start into
# it, and a change that sync did not commit waits for the timer's next run.
#
# Without a clone, when the clone is deleted or moved, or when inotifywait
# stops, the script exits 1 and the unit starts it again. While another
# process, a shell say, has its working directory anywhere inside the clone,
# its deletion is reported only once that process has left.
# MEMEX_DIR overrides the clone (default ~/memex), MEMEX_WATCH_DELAY the
# 30 seconds.
set -euo pipefail

repo=${MEMEX_DIR:-$HOME/memex}
delay=${MEMEX_WATCH_DELAY:-30}
# Matched against paths relative to the clone, with a leading slash.
ignored='^/(.*/)?\.(git|obsidian)(/|$)'

log() { printf 'memex-watch: %s\n' "$*"; }

# Returns once $delay seconds pass without a change; fails when the changes
# end.
quiet_for_delay() {
  local status=0
  until [ "$status" -ne 0 ]; do
    IFS= read -r -t "$delay" _ || status=$?
  done
  # read returns more than 128 on a timeout and 1 at the end of input.
  [ "$status" -gt 128 ]
}

# Reads inotifywait's events and prints the path of each change that counts.
# Returns when the clone itself is deleted or moved, which ends the changes.
changes() {
  local event path
  while IFS=' ' read -r event path; do
    path=${path#"$root"}
    if [ "$path" = / ]; then
      case $event in
        DELETE_SELF* | MOVE_SELF*)
          log "$root was deleted or moved" >&2
          return
          ;;
      esac
    fi
    [[ $path =~ $ignored ]] || printf '%s\n' "$path"
  done
}

if [ ! -d "$repo" ]; then
  log "cannot watch $repo: no such directory" >&2
  exit 1
fi
# An absolute path, and no working directory inside the clone: while any
# process has its working directory there, deleting the clone is not
# reported.
root=$(readlink -f -- "$repo")
# changes reads inotifywait through a process substitution, not a pipe: the
# shell running such a pipe would hold it open until inotifywait ends, even
# after changes returned.
while IFS= read -r _; do
  quiet_for_delay || break
  log "quiet for $delay s after a change; starting memex-sync"
  systemctl --user start --no-block memex-sync.service ||
    log "could not start memex-sync.service" >&2
done < <(changes < <(inotifywait --quiet --monitor --recursive \
  --event close_write,create,delete,move,delete_self,move_self \
  --format '%e %w%f' "$root"))
log "stopped watching $root" >&2
exit 1
