# Steamdeck-specific git config. Included by shared .gitconfig via [include] path.

[user]
	name = danielcopper
	email = daniel.kueppermann@gmail.com

[safe]
	directory = /home/deck/Repos/romm-tender

[credential]
	# Forgejo-Token im Keyring statt Klartext
	helper = /usr/lib/git-core/git-credential-libsecret

# The signing key is host-specific; signing itself is switched on in the shared .gitconfig.
[user]
	signingkey = ~/.ssh/id_ed25519_github.pub
