# Claude Code - Sensitive and temporary files
# Include this in your dotfiles to avoid committing sensitive data

# Credentials and API keys
.credentials.json
*.key
*.pem

# Session data
history.jsonl
session-env/
projects/

# Temporary files
debug/
shell-snapshots/
file-history/
todos/

# Stats and analytics
statsig/

# Hook logs (these contain session data)
hooks/logs/

# claude.ai account skills, cached by Claude Code on each sync (carry account ids)
skills/synced/

# Keep these (configuration and custom code)
# settings.json
# README.md
# hooks/*.py (but not logs/)
# skills/

# Memory: track machinery (README, .gitkeep) and ignore personal content (general.md, tools/*.md, domain/*.md, daily/**)
memory/**/*.md
!memory/README.md
__pycache__/
