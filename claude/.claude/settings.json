{
  "cleanupPeriodDays": 90,
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git mv:*)",
      "Bash(git worktree:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git remote:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git stash push:*)",
      "Bash(git stash pop:*)",
      "Bash(git stash apply:*)",
      "Bash(git stash list:*)",
      "Bash(git stash show:*)",
      "Bash(gh issue:*)",
      "Bash(gh search:*)",
      "Bash(gh api:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(mise trust:*)",
      "Bash(mise install:*)",
      "Bash(mise run test:*)",
      "Bash(sqlcmd -S localhost -U sa -C:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:deepwiki.com)",
      "Read(~/Repos/**)",
      "Read(~/repos/**)",
      "Read(/tmp/**)",
      "Read(~/.claude/feature-progress/**)",
      "Bash(cd:*)",
      "Bash(git -C:*)",
      "Bash(git reset:*)",
      "Bash(git rm:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh release download:*)",
      "Bash(mise run:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(.venv/bin/basedpyright:*)",
      "Bash(deno fmt:*)",
      "Bash(python3:*)",
      "Bash(sonar list:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(awk:*)",
      "Bash(grep:*)",
      "Bash(diff:*)",
      "Bash(find:*)"
    ],
    "deny": [],
    "ask": [
      "Bash(*registration.yaml*)",
      "Bash(*mautrix-*/config.yaml*)",
      "Bash(*/srv/secrets/*)",
      "Bash(*homeserver.yaml*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.dev)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.staging)",
      "Read(**/.env.stage)",
      "Read(**/.env.test)",
      "Read(**/.envrc)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.dev)",
      "Edit(**/.env.production)",
      "Edit(**/.env.prod)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.stage)",
      "Edit(**/.env.test)",
      "Edit(**/.envrc)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable",
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/notification.py --notify",
            "timeout": 25
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/post_tool_use.py --notify",
            "timeout": 25
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/pre_compact.py --backup",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"AskUserQuestion is disabled. Do NOT use it. Ask your question(s) as plain text in your normal response, then stop and wait for the user reply. Never proceed on best judgment for a decision that needs the user just because a prompt timed out - a plain-text turn waits with no timeout.\"}}'"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/memory_inject.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/sonar-secrets/build-scripts/pretool-secrets.sh",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/block_ai_attribution.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/block_commit_on_main.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/block_dangerous_bash.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/block_dangerous_git.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/block_plugin_code_reviewer.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/session_start.py --load-context",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/remote_settings_watch.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/stop.py --notify",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/subagent_stop.py --notify",
            "timeout": 25
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/user_prompt_submit.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/sonar-secrets/build-scripts/prompt-secrets.sh",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 1
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "sonarqube@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "viewMode": "default",
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "voice": {
    "enabled": true
  },
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(ansible-playbook:*) in /home/deck/Repos/homelab — routine automation tool for this repo, frequently used, not covered by a default allow label"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: Not queryable via gh (remote host git.kueppermann.com is not a supported/derivable owner/repo shape) — assume private (self-hosted git instance, no public-visibility signal found)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: main (default branch, per repo facts); protection status not queryable via gh for this host",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine (Steam Deck-style dev host) with open internet",
      "**Source control**: The homelab repo at git.kueppermann.com/daniel/homelab and its origin remote only (no additional orgs configured)",
      "**Trusted internal domains**: git.kueppermann.com, auth.kueppermann.com, photos.kueppermann.com, search.kueppermann.com, chat.kueppermann.com, music.kueppermann.com, cupr.dev, auth.cupr.dev, chat.cupr.dev, matrix.cupr.dev — self-hosted homelab/personal-infra hosts seen repeatedly in this project's usage",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: 192.168.178.153, 192.168.178.83, 192.168.178.20 (homelab LAN hosts contacted repeatedly in this project's usage)",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: infra/unraid/scripts/crowdsec-home-allowlist.sh (allowlist/security-config script — treat as sensitive infra config); any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment; homelab infra/ paths (e.g. infra/unraid/*) touching host allowlists/firewall config",
      "### User-specific",
      "**Primary use of Claude Code**: homelab infrastructure automation (Ansible, self-hosted services) — personal/hobby use",
      "**Trusted repo**: /home/deck/Repos/homelab (working directory) and its origin remote git.kueppermann.com/daniel/homelab.git — visibility assumed private; treat confidential homelab material as fine to commit here but not to push to unrelated public destinations",
      "**Org-specific CLIs**: ansible-playbook (routine under this repo — 17 uses)",
      "routine under /home/deck/Repos/homelab/ prefix qualifiers apply to the org-specific CLI and internal-domain entries above"
    ]
  }
}
