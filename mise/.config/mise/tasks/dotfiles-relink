#!/usr/bin/env bash
# Global mise task: re-link stow packages after a pull that touched the dotfiles
# repo. `mise run dotfiles-pull` pulls and then runs this in the same command.
#
# New files in a package have no symlink yet, and for claude/.claude/hooks/ that
# is not cosmetic: settings.json wires a hook the moment its entry lands, while
# the script it names is still only in the repo, and every Bash call then fails
# with "can't open file" - including the stow that would fix it. A hook script
# the pull deleted breaks things the same way while the live settings.json still
# names it, and blocks Edit and Write too. So after the stow, every hook entry in
# the live settings.json whose script the repo once tracked under
# claude/.claude/hooks/ and has since deleted is removed, with a backup and a
# printout. Any other missing path in a hook command - a script another tool
# installed into ~/.claude/hooks/ (sonar-secrets), an argument - is only
# reported, and the task fails.
#
# ~/.claude/settings.json is NOT stowed. It is the live file Claude Code writes
# model, effort and the auto-mode environment into; the repo keeps a reference
# copy under claude/.claude/settings.json to diff against. Only entries for
# missing hook scripts are taken out of it here.
#
# Usage: mise run dotfiles-relink [package...]   (defaults to claude)
set -euo pipefail

dotfiles="${DOTFILES_DIR:-$HOME/dotfiles}"
[ -d "$dotfiles" ] || { echo "dotfiles-relink: no such directory: $dotfiles" >&2; exit 1; }
cd "$dotfiles"

packages=("$@")
[ ${#packages[@]} -eq 0 ] && packages=(claude)

stow -R "${packages[@]}"
echo "✓ relinked: ${packages[*]}"

settings="$HOME/.claude/settings.json"
[ -f "$settings" ] || exit 0

python3 - "$settings" "$dotfiles" <<'PY'
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

settings = Path(sys.argv[1])
repo_hooks = Path(sys.argv[2]) / "claude/.claude/hooks"
live_hooks = Path.home() / ".claude/hooks"
data = json.loads(settings.read_text())
path_ref = re.compile(r"(?:\$HOME|~)/\S+")


def missing_paths(command):
    paths = (Path(os.path.expandvars(os.path.expanduser(ref))) for ref in path_ref.findall(command))
    return [path for path in paths if not path.exists()]


def deleted_from_repo(path):
    if not path.is_relative_to(live_hooks):
        return False
    repo_path = repo_hooks / path.relative_to(live_hooks)
    if repo_path.exists():
        return False
    history = subprocess.run(
        ["git", "-C", str(repo_hooks), "log", "-1", "--format=%H", "--", str(repo_path)],
        capture_output=True, text=True, check=True,
    )
    return bool(history.stdout.strip())


removed = []
unresolved = []
events = data.get("hooks", {})
for event, groups in list(events.items()):
    kept_groups = []
    for group in groups:
        kept = []
        for hook in group.get("hooks", []):
            entry = f"{event} [{group.get('matcher', '')}]: {hook.get('command', '')}"
            missing = missing_paths(hook.get("command", ""))
            if missing and all(deleted_from_repo(path) for path in missing):
                removed.append(entry)
                continue
            if missing:
                unresolved.append(entry)
            kept.append(hook)
        if kept:
            kept_groups.append({**group, "hooks": kept})
    if kept_groups:
        events[event] = kept_groups
    else:
        del events[event]

if removed:
    shutil.copy2(settings, settings.with_name(settings.name + ".bak"))
    with tempfile.NamedTemporaryFile("w", dir=settings.parent, delete=False) as tmp:
        tmp.write(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
    shutil.copymode(settings, tmp.name)
    os.replace(tmp.name, settings)
    print(f"✓ removed hook entries whose script the dotfiles repo no longer has from {settings} (backup: {settings.name}.bak):")
    for entry in removed:
        print(f"    {entry}")

if unresolved:
    print(f"✗ {settings} names paths that do not exist and are not dotfiles hook scripts; fix by hand:", file=sys.stderr)
    for entry in unresolved:
        print(f"    {entry}", file=sys.stderr)
    sys.exit(1)

if not removed:
    print(f"✓ every hook script in {settings} exists")
PY
