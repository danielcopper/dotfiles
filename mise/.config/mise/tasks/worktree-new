#!/usr/bin/env bash
# Global mise task: create a .claude/worktrees/<type>/<slug> worktree and, if the repo
# uses mise, trust the fresh worktree's config and run its `setup` task — so the
# empty per-worktree .venv / deps get populated and tooling (tests, linters, LSP)
# work immediately. Pair with EnterWorktree({ path: ".claude/worktrees/<type>/<slug>" })
# to re-root the Claude session into the worktree for clean diagnostics. .claude/
# worktrees/ is Claude Code's native worktree location, so EnterWorktree fires no
# permission-root relocation prompt.
#
# Usage: mise run worktree-new <type> <slug> [base]   (base defaults to current branch)
set -euo pipefail

type="${1:?usage: mise run worktree-new <type> <slug> [base=current branch]}"
slug="${2:?usage: mise run worktree-new <type> <slug> [base=current branch]}"

# mise runs a *global* file task from the global config root ($HOME), not from
# where it was invoked — so resolve everything against MISE_ORIGINAL_CWD (the
# caller's dir). --git-common-dir always points at the MAIN worktree's .git, so
# .claude/worktrees/ lands beside src/ even when invoked from inside another worktree
# (never nested). PWD is the fallback when run outside mise.
orig="${MISE_ORIGINAL_CWD:-$PWD}"
if ! common_git="$(git -C "$orig" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
  echo "worktree-new: not inside a git repository (cwd: $orig)" >&2
  exit 1
fi
repo_root="$(dirname "$common_git")"

# Default base = the branch the caller is standing in (a SHA if detached).
default_base="$(git -C "$orig" rev-parse --abbrev-ref HEAD)"
[ "$default_base" = "HEAD" ] && default_base="$(git -C "$orig" rev-parse HEAD)"
base="${3:-$default_base}"

cd "$repo_root"
wt=".claude/worktrees/${type}/${slug}"

git worktree add "$wt" -b "${type}/${slug}" "$base"

# Only the mise dance if the repo actually uses mise.
if [ -f "$wt/mise.toml" ] || [ -f "$wt/.mise.toml" ] || [ -f "$wt/.config/mise/config.toml" ]; then
  mise -C "$wt" trust >/dev/null 2>&1 || true
  if mise -C "$wt" tasks 2>/dev/null | grep -qw setup; then
    mise -C "$wt" run setup
  fi
fi

echo "✓ worktree ready: $repo_root/$wt  (branch ${type}/${slug}, base ${base})"
echo "  next: EnterWorktree({ path: \"$wt\" })  — re-roots the session for clean LSP/tooling"
