#!/usr/bin/env bash
# Global mise task: run the install-dotfiles.sh tests from the dotfiles repo;
# what they check is in the headers of tests/install-dotfiles/memory-link.sh
# and shared-dirs.sh.
#
# Usage: mise run install-dotfiles-test [case...]   (defaults to all)
#   Each case runs from the test file that lists it.
set -euo pipefail

dotfiles="${DOTFILES_DIR:-$HOME/dotfiles}"
tests="$dotfiles/tests/install-dotfiles"
[ -d "$tests" ] || { echo "install-dotfiles-test: no such directory: $tests" >&2; exit 1; }
run_listed="$dotfiles/tests/run-listed.sh"
[ -f "$run_listed" ] || { echo "install-dotfiles-test: no such file: $run_listed" >&2; exit 1; }

exec "$run_listed" install-dotfiles-test "$tests/memory-link.sh" "$tests/shared-dirs.sh" -- "$@"
