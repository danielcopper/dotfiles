#!/usr/bin/env bash
# Global mise task: run the tests of the herdr board mod from the dotfiles
# repo with node's test runner; README, "herdr app", says what they cover.
# They run under node's permission model: reads only in the repo and the
# temporary folder, writes only in the temporary folder. Child processes are
# allowed (the runner starts each test file as one, under the same limits;
# the sh the checkout test runs is not bound by them). BOARD_TEST_PERMISSION
# tells the tests they must run under those limits. The tests run twice:
# against the built main.js, the file herdr loads, and against src/main.js,
# where a module that uses a name it does not import fails, wherever a test
# reaches that use (in main.js all modules share one scope, so there it
# would not).
#
# Usage: mise run herdr-board-test [node --test option...]
#   e.g. --test-name-pattern=UI
set -euo pipefail

dotfiles="${DOTFILES_DIR:-$HOME/dotfiles}"
test="$dotfiles/tests/herdr-app/board.test.mjs"
[ -f "$test" ] || { echo "herdr-board-test: no such file: $test" >&2; exit 1; }
tmp="${TMPDIR:-/tmp}"

# From the repo and by a relative path: the test runner looks an absolute
# path up from /, which the permission model does not let it read.
cd "$dotfiles"
export BOARD_TEST_PERMISSION=1
run() {
  node --permission --allow-fs-read="$dotfiles" --allow-fs-read="$tmp" --allow-fs-write="$tmp" --allow-child-process \
    --test "$@" tests/herdr-app/board.test.mjs
}
echo "herdr-board-test: against main.js"
run "$@"
echo "herdr-board-test: against src/main.js"
BOARD_MAIN=herdr-app/.config/herdr-app/mods/board/src/main.js run "$@"
