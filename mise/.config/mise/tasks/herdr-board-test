#!/usr/bin/env bash
# Global mise task: run the tests of the herdr board mod from the dotfiles
# repo with node's test runner; README, "herdr app", says what they cover.
# They run under node's permission model: reads only in the repo and the
# temporary folder, writes only in the temporary folder; child processes
# (sh) are allowed and are not bound by it.
#
# Usage: mise run herdr-board-test [node --test option...]
#   e.g. --test-name-pattern=UI
set -euo pipefail

dotfiles="${DOTFILES_DIR:-$HOME/dotfiles}"
test="$dotfiles/tests/herdr-app/board.test.mjs"
[ -f "$test" ] || { echo "herdr-board-test: no such file: $test" >&2; exit 1; }
tmp="${TMPDIR:-/tmp}"

# From the repo and by a relative path: the test runner looks an absolute
# path up from /, which the permission model does not let it read.
cd "$dotfiles"
exec node --permission --allow-fs-read="$dotfiles" --allow-fs-read="$tmp" --allow-fs-write="$tmp" --allow-child-process \
  --test "$@" tests/herdr-app/board.test.mjs
