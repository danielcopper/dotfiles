#!/usr/bin/env bash
# Global mise task: run the memex-sync scenario tests from the dotfiles repo
# against the repo's memex/.local/bin/memex-sync and memex-watch.
# What they need is listed in the repo's README, section "memex sync".
#
# Usage: mise run memex-sync-test [scenario...]          (defaults to all)
#        mise run memex-sync-test --mutants [memex-sync] (break each guard in turn)
set -euo pipefail

dotfiles="${DOTFILES_DIR:-$HOME/dotfiles}"
tests="$dotfiles/tests/memex-sync"
[ -d "$tests" ] || { echo "memex-sync-test: no such directory: $tests" >&2; exit 1; }

if [ "${1:-}" = --mutants ]; then
  exec python3 -I "$tests/mutants.py" "${@:2}"
fi
run_listed="$dotfiles/tests/run-listed.sh"
[ -f "$run_listed" ] || { echo "memex-sync-test: no such file: $run_listed" >&2; exit 1; }

exec "$run_listed" memex-sync-test "$tests/scenarios.sh" -- "$@"
