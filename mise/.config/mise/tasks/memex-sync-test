#!/usr/bin/env bash
# Global mise task: run the memex-sync scenario tests from the dotfiles repo
# against the repo's memex/.local/bin/memex-sync and memex-watch.
# What they need is listed in the repo's README, section "memex sync".
#
# Usage: mise run memex-sync-test [scenario...]          (defaults to all)
#        mise run memex-sync-test --mutants              (break each guard in turn)
set -euo pipefail

dotfiles="${DOTFILES_DIR:-$HOME/dotfiles}"
tests="$dotfiles/tests/memex-sync"
[ -d "$tests" ] || { echo "memex-sync-test: no such directory: $tests" >&2; exit 1; }

if [ "${1:-}" = --mutants ]; then
  exec python3 -I "$tests/mutants.py"
fi
scenarios="$tests/scenarios.sh"
# listed[scenario]: the names scenarios.sh --list prints. A failing --list
# stops the run.
if ! list=$("$scenarios" --list); then
  echo "memex-sync-test: $scenarios --list failed" >&2
  exit 1
fi
declare -A listed=()
mapfile -t names <<<"$list"
for name in "${names[@]}"; do listed[$name]=1; done
for name in "$@"; do
  [ -n "$name" ] && [ -n "${listed[$name]+set}" ] || { echo "memex-sync-test: no such scenario: $name" >&2; exit 1; }
done
exec "$scenarios" "$@"
