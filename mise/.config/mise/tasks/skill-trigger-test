#!/usr/bin/env bash
# Global mise task: run the skill trigger check of the dotfiles repo; README,
# "Tests", says when and how.
#
# Usage: mise run skill-trigger-test [run.py option...] [case...]
#        mise run skill-trigger-test --test [unittest option...]
set -euo pipefail

dotfiles="${DOTFILES_DIR:-$HOME/dotfiles}"
runner="$dotfiles/tests/skill-triggers/run.py"
[ -f "$runner" ] || { echo "skill-trigger-test: no such file: $runner" >&2; exit 1; }

if [ "${1:-}" = --test ]; then
  exec python3 -I "$dotfiles/tests/skill-triggers/run-test.py" "${@:2}"
fi
exec python3 -I "$runner" "$@"
