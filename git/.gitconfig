[http]
	lowSpeedLimit = 1000
	lowSpeedTime = 60
	postBuffer = 524288000

[core]
	# Global hooks path — pre-push runs gitleaks on every repo.
	# Project-local override: `git config core.hooksPath .git/hooks`.
	hooksPath = ~/.githooks

# Every commit and tag is signed with an SSH key. Which key is host-specific:
# user.signingkey lives in host-<class>/.gitconfig.local, and a host without one
# cannot commit until it sets it or switches signing off there.
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[init]
	defaultBranch = main

# [user] is host-specific (work-default on wsl, personal on arch/steamdeck).
# Set in host-<class>/.gitconfig.local via [include] below. The include comes
# last so a host can override anything above.
[include]
	path = ~/.gitconfig.local
