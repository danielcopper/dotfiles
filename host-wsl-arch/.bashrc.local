# WSL-arch-specific bash config. Sourced by shared .bashrc.
#
# shellcheck shell=bash

# Prevent Claude Code from spawning powershell.exe ~38x on startup to resolve
# this variable. Each call takes ~700ms on WSL2, causing 30-60s input freeze.
# https://github.com/anthropics/claude-code/issues/29672
export USERPROFILE="/mnt/c/Users/KueppermannD"

# dbt profiles location
export DBT_PROFILES_DIR="$HOME/.config/dbt"

# Carapace shell completions (with cross-shell bridges)
export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
# Generated by carapace, not in this repo.
# shellcheck source=/dev/null
command -v carapace >/dev/null && source <(carapace _carapace)

# Pkgfile command-not-found; a system file, not in this repo.
# shellcheck source=/dev/null
[ -r /usr/share/doc/pkgfile/command-not-found.bash ] && \
  . /usr/share/doc/pkgfile/command-not-found.bash

# Auto-start gnome-keyring for MSAL token storage (WSL needs this manually).
# A shell that did not inherit GNOME_KEYRING_CONTROL decides on the daemon's
# control socket, not on which shell it is: herdr started from the Start menu
# hands its terminals no GNOME_KEYRING_CONTROL, so any of them may be the
# first. The daemon keeps the socket in $XDG_RUNTIME_DIR/keyring. With the
# socket there, the shell takes that daemon; without it, it starts one. The
# lock makes shells that start at once, such as several herdr panes, take
# turns, and --start in the later ones attaches to the daemon already running.
if [ -z "${GNOME_KEYRING_CONTROL:-}" ]; then
    keyring_run=${XDG_RUNTIME_DIR:-/run/user/$UID}
    if [ -S "$keyring_run/keyring/control" ]; then
        GNOME_KEYRING_CONTROL=$keyring_run/keyring
    else
        mkdir -p "$keyring_run/keyring" 2>/dev/null
        eval "$(flock "$keyring_run/keyring.lock" \
            gnome-keyring-daemon --start --components=secrets 2>/dev/null)"
    fi
    [ -n "${GNOME_KEYRING_CONTROL:-}" ] && export GNOME_KEYRING_CONTROL
    unset keyring_run
fi

# Force Azure Artifacts Credential Provider to use device-code flow instead
# of MSAL loopback (localhost:44927 callback). Loopback fails under WSL2
# mirrored networking because MSAL binds 127.0.0.1 but Windows resolves
# localhost to ::1 first → browser hits an IPv6 socket nobody's listening on.
# Device-code prints a URL+code, you paste in any browser → token is cached.
export NUGET_CREDENTIALPROVIDER_FORCE_CANSHOWDIALOG_TO=false

# opencode CLI on PATH
[ -d "$HOME/.opencode/bin" ] && export PATH="$HOME/.opencode/bin:$PATH"

# OpenCode: host-local config (the LiteLLM provider on the internal network),
# merged over the shared ~/.config/opencode/opencode.jsonc. Not in this repo.
export OPENCODE_CONFIG="$HOME/.config/opencode/local.jsonc"
