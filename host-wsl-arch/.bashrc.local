# WSL-arch-specific bash config. Sourced by shared .bashrc.
#
# shellcheck shell=bash

# Prevent Claude Code from spawning powershell.exe ~38x on startup to resolve
# this variable. Each call takes ~700ms on WSL2, causing 30-60s input freeze.
# https://github.com/anthropics/claude-code/issues/29672
export USERPROFILE="/mnt/c/Users/KueppermannD"

# dbt profiles location
export DBT_PROFILES_DIR="$HOME/.config/dbt"

# Carapace shell completions (with cross-shell bridges)
export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
# Generated by carapace, not in this repo.
# shellcheck source=/dev/null
command -v carapace >/dev/null && source <(carapace _carapace)

# Pkgfile command-not-found; a system file, not in this repo.
# shellcheck source=/dev/null
[ -r /usr/share/doc/pkgfile/command-not-found.bash ] && \
  . /usr/share/doc/pkgfile/command-not-found.bash

# Auto-start gnome-keyring for MSAL token storage (WSL needs this manually).
# Every shell that inherited no GNOME_KEYRING_CONTROL asks the daemon, whichever
# shell it is: herdr started from the Start menu hands its terminals none.
# `--start` attaches to the daemon whose control socket is in
# $XDG_RUNTIME_DIR/keyring; when none answers there (no socket, or one a dead
# daemon left), it starts a new one, which creates that directory at 0700
# itself. It prints GNOME_KEYRING_CONTROL only for another directory, so after
# a successful start the variable is otherwise taken from the socket. After a
# failed start the socket may be a dead daemon's, so the variable stays unset
# and a child shell asks again. The lock makes shells that start at once, such
# as several herdr panes, take turns: the first starts the daemon, the later
# ones attach to it. -o keeps the lock out of the daemon, which would otherwise
# hold it for its whole life; -w 5 bounds the wait. A shell that gave up on the
# lock, or whose start failed, says so in one line on stderr; an interrupted
# start (Ctrl-C, TERM) stays silent. Without XDG_RUNTIME_DIR the daemon has no
# fixed directory a later shell could find, so the block leaves it alone.
if [ -z "${GNOME_KEYRING_CONTROL:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    keyring_env=$(flock -o -w 5 -E 75 "$XDG_RUNTIME_DIR/keyring.lock" \
        gnome-keyring-daemon --start --components=secrets 2>/dev/null)
    keyring_status=$?
    if [ "$keyring_status" = 0 ]; then
        eval "$keyring_env"
        if [ -z "${GNOME_KEYRING_CONTROL:-}" ] && [ -S "$XDG_RUNTIME_DIR/keyring/control" ]; then
            GNOME_KEYRING_CONTROL=$XDG_RUNTIME_DIR/keyring
        fi
        [ -n "${GNOME_KEYRING_CONTROL:-}" ] && export GNOME_KEYRING_CONTROL
    elif [ "$keyring_status" = 75 ]; then
        echo "keyring: $XDG_RUNTIME_DIR/keyring.lock busy for 5 s, GNOME_KEYRING_CONTROL not set" >&2
    elif [ "$keyring_status" != 130 ] && [ "$keyring_status" != 143 ]; then
        echo "keyring: gnome-keyring-daemon --start failed (exit $keyring_status), GNOME_KEYRING_CONTROL not set" >&2
    fi
    unset keyring_env keyring_status
fi

# Force Azure Artifacts Credential Provider to use device-code flow instead
# of MSAL loopback (localhost:44927 callback). Loopback fails under WSL2
# mirrored networking because MSAL binds 127.0.0.1 but Windows resolves
# localhost to ::1 first → browser hits an IPv6 socket nobody's listening on.
# Device-code prints a URL+code, you paste in any browser → token is cached.
export NUGET_CREDENTIALPROVIDER_FORCE_CANSHOWDIALOG_TO=false

# opencode CLI on PATH
[ -d "$HOME/.opencode/bin" ] && export PATH="$HOME/.opencode/bin:$PATH"

# OpenCode: host-local config (the LiteLLM provider on the internal network),
# merged over the shared ~/.config/opencode/opencode.jsonc. Not in this repo.
export OPENCODE_CONFIG="$HOME/.config/opencode/local.jsonc"
