#!/usr/bin/env -S python3 -I
"""Write a page that shows images at their real size, side by side as they fit.

usage: image-page [--density D] [--title T] [--replace] <out-dir>
                  [--section TITLE] <image>[::caption] ... [--section TITLE <image> ...]

Copies each image into <out-dir>, under its own basename, and writes
<out-dir>/index.html: the images in the order given, each with its caption
above it, the basename without its extension unless <image>::caption gives
one (an empty caption falls back to that default), and the image's pixel
size beside the caption. Each image's CSS width is its pixel width divided
by D, rounded half up and at least 1 px, its height follows, and
max-width:100% keeps it inside a narrow screen. D is the density the image
was drawn at, in pixels per CSS pixel, such as an Android render's 2.625;
a screenshot takes the scale of the screen it was taken on (a phone's
density, a desktop's scale factor); photos take none, and without --density
D is 1. The pixel size is read from the file itself: PNG, JPEG, GIF or
WebP. A line at the top names the number of images and D. --title sets the
page's <title> and an <h1>; without it the <title> is the out-dir's name.
Captions, title and file names are HTML-escaped. The page follows the
viewer's light or dark setting and loads nothing from elsewhere. Options
may stand anywhere before --; a --title or --section value that starts with
- goes after an =, as --title=-x.

--section TITLE (or --section=TITLE) among the images starts a section: a
heading, then the images after it up to the next --section. Images before
the first --section form a section without a heading. Each section lays its
images out in rows of figures as wide as its widest image, as many side by
side as the screen holds and one on a phone, each row centered under the
left-aligned heading; the page is centered and as wide as its widest
section with all its images in one row, at least 40rem. Every
--section needs a title that is not blank and an image after it, and
<out-dir> comes before the first one; after -- a --section is an image
name.

It creates <out-dir>, parents too, when it is missing, prints the path of
index.html and starts no server: run `preview-serve <out-dir>` to show it.
It also writes .image-page.json there, the list of what it wrote, which
--replace reads.

It writes the page into a new directory beside <out-dir> and puts that in
place of <out-dir> only once every file is written, so a page never mixes
old files and a run that fails leaves the earlier page as it was, unless
putting it back fails too (below). So the parent of <out-dir> must be
writable, even when <out-dir> itself is. Into an empty <out-dir> it moves
the files one by one, .image-page.json first and index.html last, so
--replace can clear what a failed move left there. When putting the new
page in place fails and putting the earlier one back fails too, it says
where the earlier page is; when only removing the earlier page afterwards
fails, it warns and exits 0.

It refuses, before it writes anything, and exits 1:
- an image whose pixel size it cannot read, or that it cannot read at all;
- a --density so small that an image's CSS width overflows;
- two images with the same basename, or an image named index.html or
  .image-page.json;
- an <out-dir> that is no directory, or that it cannot list;
- an <out-dir> that is not empty, unless --replace is given and the
  directory holds only what an earlier image-page run wrote there (the
  files its .image-page.json names, index.html and that list);
- --replace on the current directory, or one that holds it, when it holds a
  page: the swap would move it away from under the caller.

Exit codes: 0 written, 1 refused, 2 usage (an unknown option, an option
without its value, a --title or --section value after a space that starts
with -, a --section without a title or an image after it, or before
<out-dir>, a --density that is no positive decimal number, too large for a
float or too small to be told from 0, no <out-dir> or no image), 3 the page
could not be written in <out-dir> (a full disk, a directory it may not
write); the earlier page, if any, stays, or the message says where it went.
"""

import html
import json
import math
import os
import re
import shutil
import struct
import sys
import tempfile
import urllib.parse
from typing import NoReturn

MANIFEST = ".image-page.json"
INDEX = "index.html"
USAGE = """\
usage: image-page [--density D] [--title T] [--replace] <out-dir> [--section TITLE] <image>[::caption] ...
  Writes <out-dir>/index.html with the images at their real size, each CSS
  pixel D image pixels (default 1), side by side as they fit; --section
  TITLE before an image starts a section with that heading. Show it with:
  preview-serve <out-dir>"""
# The grid's gap between columns, in CSS px: the .grid rule in STYLE and the
# page width in render() both take it from here.
COLUMN_GAP = 24
# A centered page of sections, each in centered rows of figures at their
# real size that wrap (flex, so a short last row is centered too, which a
# column grid would leave in its first columns), each caption above its
# image; the page's own colors are tokens, light first, dark redefined.
STYLE = """\
:root{--bg:#f1f3f6;--fg:#1b1f27;--muted:#596173;--rule:#d8dce3;\
--font-text:system-ui,-apple-system,"Segoe UI",Roboto,"Noto Sans",sans-serif;\
--font-mono:ui-monospace,"SF Mono","Cascadia Mono","DejaVu Sans Mono",monospace;color-scheme:light}
@media (prefers-color-scheme: dark){:root{--bg:#15181d;--fg:#e4e7ec;--muted:#99a1af;--rule:#2c313a;color-scheme:dark}}
body{margin:0;padding-block:24px 48px;\
padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));\
background:var(--bg);color:var(--fg);font:16px/1.5 var(--font-text)}
.page{width:100%;max-width:max(40rem,var(--page));margin-inline:auto;display:grid;gap:32px;min-width:0}
header{display:grid;gap:4px;padding-bottom:16px;border-bottom:1px solid var(--rule);min-width:0}
h1{margin:0;font-size:1.375rem;font-weight:600;line-height:1.25;text-wrap:balance;overflow-wrap:anywhere}
.meta,.size{color:var(--muted);font-family:var(--font-mono);font-size:0.8125rem;font-weight:400;font-variant-numeric:tabular-nums}
.meta{margin:0}
section{display:grid;gap:12px;min-width:0}
h2{margin:0;font-size:1.0625rem;font-weight:600;line-height:1.3;text-wrap:balance;overflow-wrap:anywhere}
.grid{display:flex;flex-wrap:wrap;justify-content:center;gap:32px COLUMN_GAPpx}
.grid>figure{flex:0 0 var(--col);max-width:100%}
figure{margin:0;display:grid;gap:8px;align-content:start;justify-items:start;min-width:0}
figcaption{display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 12px;font-size:0.9375rem;font-weight:500;overflow-wrap:anywhere}
img{display:block;height:auto;max-width:100%}
""".replace("COLUMN_GAP", str(COLUMN_GAP))


class Refused(Exception):
    """A reason to stop with exit 1, before anything is written."""


class PageLost(Exception):
    """The new page could not be put in place, nor the earlier one back.

    error is why the new page could not; old is where the earlier page is.
    """

    def __init__(self, error, old):
        super().__init__(error, old)
        self.error, self.old = error, old


def usage(reason) -> NoReturn:
    print(f"image-page: {reason}\n{USAGE}", file=sys.stderr)
    sys.exit(2)


def density(value):
    # A plain decimal only: float() also takes nan, inf, 1e3 and 1_0.
    if not re.fullmatch(r"[0-9]+(\.[0-9]*)?|\.[0-9]+", value) or not 0 < float(value) < math.inf:
        usage(f"--density {value!r} is no positive decimal number, too large for a float or too small to be told from 0")
    return float(value)


class Section(str):
    """A --section title among the image arguments."""


def parse(argv):
    """(options, <out-dir>, the images and Section titles in the order given)."""
    opts = {"density": 1.0, "title": None, "replace": False}
    positional = []
    args = iter(argv)
    for arg in args:
        if arg == "--":
            positional.extend(args)
            break
        name, eq, value = arg.partition("=")
        if name in ("--density", "--title", "--section"):
            if not eq:
                value = next(args, None)
                if value is None:
                    usage(f"{name} needs a value")
                # After a space a value that looks like an option is most
                # likely a missing one: --section --replace, --title -- a.png.
                if name != "--density" and value.startswith("-"):
                    usage(f"give a value that starts with - as {name}={value}")
            if name == "--section":
                if not value.strip():
                    usage("--section needs a title")
                positional.append(Section(value))
            else:
                opts[name[2:]] = density(value) if name == "--density" else value
        elif arg == "--replace":
            opts["replace"] = True
        elif arg.startswith("-") and arg != "-":
            usage(f"unknown option {arg}")
        else:
            positional.append(arg)
    if positional and isinstance(positional[0], Section):
        usage("<out-dir> comes before the first --section")
    for item, after in zip(positional, [*positional[1:], None]):
        if isinstance(item, Section) and (after is None or isinstance(after, Section)):
            usage(f"--section {item} has no image after it")
    if len(positional) < 2:
        usage("an <out-dir> and at least one image are needed")
    return opts, positional[0], positional[1:]


def sections(items, images):
    """[(heading or None, images)]: the loaded images grouped by the Section before them."""
    groups: list[tuple[str | None, list]] = [(None, [])]
    loaded = iter(images)
    for item in items:
        if isinstance(item, Section):
            groups.append((str(item), []))
        else:
            groups[-1][1].append(next(loaded))
    return [group for group in groups if group[0] is not None or group[1]]


def png_size(data):
    if data[12:16] != b"IHDR" or len(data) < 24:
        return None
    return struct.unpack(">II", data[16:24])


def gif_size(data):
    if len(data) < 10:
        return None
    return struct.unpack("<HH", data[6:10])


def jpeg_size(data):
    # Walks the segments up to the first frame header (SOF0-SOF15 but DHT,
    # JPG and DAC, which share the range), which holds height then width.
    pos = 2
    while pos + 4 <= len(data):
        if data[pos] != 0xFF:
            return None
        marker = data[pos + 1]
        if marker == 0xFF:
            pos += 1
            continue
        if marker == 0x01 or 0xD0 <= marker <= 0xD7:
            pos += 2
            continue
        if marker in (0xD9, 0xDA):
            return None
        (length,) = struct.unpack(">H", data[pos + 2 : pos + 4])
        if 0xC0 <= marker <= 0xCF and marker not in (0xC4, 0xC8, 0xCC):
            if pos + 9 > len(data):
                return None
            height, width = struct.unpack(">HH", data[pos + 5 : pos + 9])
            return width, height
        pos += 2 + length
    return None


def webp_size(data):
    kind, body = data[12:16], data[20:]
    if kind == b"VP8 " and len(body) >= 10 and body[3:6] == b"\x9d\x01\x2a":
        width, height = struct.unpack("<HH", body[6:10])
        return width & 0x3FFF, height & 0x3FFF
    if kind == b"VP8L" and len(body) >= 5 and body[0] == 0x2F:
        (bits,) = struct.unpack("<I", body[1:5])
        return (bits & 0x3FFF) + 1, (bits >> 14 & 0x3FFF) + 1
    if kind == b"VP8X" and len(body) >= 10:
        return int.from_bytes(body[4:7], "little") + 1, int.from_bytes(body[7:10], "little") + 1
    return None


def pixel_size(data):
    """(width, height) from the image's own header, or None."""
    if data.startswith(b"\x89PNG\r\n\x1a\n"):
        size = png_size(data)
    elif data.startswith(b"\xff\xd8"):
        size = jpeg_size(data)
    elif data[:6] in (b"GIF87a", b"GIF89a"):
        size = gif_size(data)
    elif data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        size = webp_size(data)
    else:
        return None
    return size if size and size[0] > 0 and size[1] > 0 else None


def load(specs):
    """Reads every image: [(source, name, caption, data, (width, height))]."""
    images, seen = [], {}
    for spec in specs:
        source, sep, caption = spec.partition("::")
        name = os.path.basename(source)
        try:
            with open(source, "rb") as f:
                data = f.read()
        except OSError as e:
            raise Refused(f"cannot read {source}: {e.strerror}") from None
        size = pixel_size(data)
        if size is None:
            raise Refused(f"cannot read the pixel size of {source}: no PNG, JPEG, GIF or WebP size in it")
        if name in (INDEX, MANIFEST):
            raise Refused(f"{source} would overwrite the page's own {name}")
        if name in seen:
            raise Refused(f"{seen[name]} and {source} have the same name, {name}")
        seen[name] = source
        if not (sep and caption):
            caption = os.path.splitext(name)[0]
        images.append((source, name, caption, data, size))
    return images


def own_files(out):
    """The names in <out> that an earlier run wrote, or Refused naming the first other entry."""
    manifest = os.path.join(out, MANIFEST)
    try:
        with open(manifest, encoding="utf-8") as f:
            listed = json.load(f)
    except FileNotFoundError:
        raise Refused(f"{out} holds no {MANIFEST} that names what image-page wrote there") from None
    except OSError as e:
        raise Refused(f"cannot read {manifest}: {e.strerror}") from None
    except ValueError:
        listed = None
    if not isinstance(listed, list) or not all(isinstance(n, str) for n in listed):
        raise Refused(f"{manifest} is no list of file names")
    allowed = set(listed) | {INDEX, MANIFEST}
    names = []
    with os.scandir(out) as entries:
        for entry in entries:
            if entry.name not in allowed or not entry.is_file(follow_symlinks=False):
                raise Refused(f"image-page did not write {entry.path}; it removes only its own files")
            names.append(entry.name)
    return names


def prepare(out, replace):
    """Checks <out>: ("missing", []), ("empty", []) or ("page", the names an earlier run wrote)."""
    if not os.path.lexists(out):
        return "missing", []
    if not os.path.isdir(out):
        raise Refused(f"{out} is no directory")
    try:
        if not os.listdir(out):
            return "empty", []
        if not replace:
            raise Refused(f"{out} is not empty; --replace rewrites a page image-page wrote there")
        names = own_files(out)
    except OSError as e:
        raise Refused(f"cannot read {out}: {e.strerror}") from None
    target, cwd = os.path.realpath(out), os.getcwd()
    if cwd == target or cwd.startswith(target + os.sep):
        raise Refused(f"--replace cannot swap {out}: it is the current directory or holds it; run image-page from outside it")
    return "page", names


def css_width(source, width, density_):
    """The CSS width of an image <width> pixels wide: half up, at least 1."""
    css = width / density_ + 0.5
    if not math.isfinite(css):
        raise Refused(f"--density {density_:g} makes {source} too wide to show")
    return max(1, int(css))


def render(out, groups, title, density_):
    esc = html.escape
    head_title = title if title is not None else os.path.basename(os.path.abspath(out))
    total = sum(len(images) for _, images in groups)
    count = f"{total} image{'' if total == 1 else 's'}"
    widths = [[css_width(source, size[0], density_) for source, _, _, _, size in images] for _, images in groups]
    # As wide as the widest section with all its images in one row of its
    # grid, whose columns are each as wide as its widest image.
    page_width = max(len(row) * max(row) + COLUMN_GAP * (len(row) - 1) for row in widths)
    lines = [
        "<!doctype html>",
        "<html>",
        "<head>",
        '<meta charset="utf-8">',
        '<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">',
        f"<title>{esc(head_title)}</title>",
        f"<style>\n{STYLE}</style>",
        "</head>",
        "<body>",
        f'<main class="page" style="--page:{page_width}px">',
        "<header>",
    ]
    if title is not None:
        lines.append(f"<h1>{esc(title)}</h1>")
    lines += [f'<p class="meta">{count} · density {density_:g}</p>', "</header>"]
    for (heading, images), row in zip(groups, widths):
        lines.append("<section>")
        if heading is not None:
            lines.append(f"<h2>{esc(heading)}</h2>")
        lines.append(f'<div class="grid" style="--col:{max(row)}px">')
        for (_, name, caption, _, (width, height)), css in zip(images, row):
            lines += [
                "<figure>",
                f'<figcaption><span class="name">{esc(caption)}</span> <span class="size">{width} × {height} px</span></figcaption>',
                f'<img src="{esc(urllib.parse.quote(name))}" alt="{esc(caption)}" style="width:{css}px">',
                "</figure>",
            ]
        lines += ["</div>", "</section>"]
    lines += ["</main>", "</body>", "</html>", ""]
    return "\n".join(lines)


def write_page(out, state, stale, images, page):
    """Writes the page into a new directory beside <out>, then puts it in place.

    Returns the warnings of a run whose page is in place but whose earlier
    page could not be removed.
    """
    target = os.path.realpath(out)
    parent = os.path.dirname(target)
    os.makedirs(parent, exist_ok=True)
    temp = tempfile.mkdtemp(prefix=".image-page-", dir=parent)
    try:
        mask = os.umask(0)
        os.umask(mask)
        os.chmod(temp, 0o777 & ~mask if state == "missing" else os.stat(target).st_mode & 0o7777)
        with open(os.path.join(temp, MANIFEST), "w", encoding="utf-8") as f:
            json.dump([name for _, name, _, _, _ in images], f)
        for _, name, _, data, _ in images:
            with open(os.path.join(temp, name), "wb") as f:
                f.write(data)
        with open(os.path.join(temp, INDEX), "w", encoding="utf-8") as f:
            f.write(page)
        if state == "missing":
            os.rename(temp, target)
            return []
        if state == "empty":
            # File by file, as the directory may be the caller's working
            # directory; the list first and index.html last, so a move that
            # fails leaves what --replace can clear.
            for name in [MANIFEST, *(name for _, name, _, _, _ in images), INDEX]:
                os.rename(os.path.join(temp, name), os.path.join(target, name))
            os.rmdir(temp)
            return []
        return swap(out, target, temp, stale)
    finally:
        if os.path.isdir(temp):
            shutil.rmtree(temp, ignore_errors=True)


def swap(out, target, new, stale):
    """Puts the directory <new> in place of <target>, whose earlier page goes aside and then away."""
    old = tempfile.mkdtemp(prefix=".image-page-", dir=os.path.dirname(target))
    keep_old = False
    try:
        os.rename(target, old)
        try:
            os.rename(new, target)
        except OSError as e:
            try:
                os.rename(old, target)
            except OSError:
                keep_old = True
                raise PageLost(e, old) from None
            raise
        try:
            for name in stale:
                os.remove(os.path.join(old, name))
            os.rmdir(old)
        except OSError as e:
            keep_old = True
            return [f"the page is written, but {old} could not be removed: {e.strerror}"]
        return []
    finally:
        # Empty unless it holds the earlier page: aside, or still there.
        if not keep_old and os.path.isdir(old):
            try:
                os.rmdir(old)
            except OSError:
                pass


def write_error(out, e):
    """The exit-3 message: why the page is not in <out>, and where an earlier page went."""
    if isinstance(e, PageLost):
        return f"cannot write the page in {out}: {e.error.strerror or e.error}; {out} is missing; the earlier page is at {e.old}"
    detail = f" ({e.filename})" if e.filename else ""
    return f"cannot write the page in {out}: {e.strerror or e}{detail}"


def main(argv):
    opts, out, items = parse(argv)
    try:
        images = load([item for item in items if not isinstance(item, Section)])
        state, stale = prepare(out, opts["replace"])
        page = render(out, sections(items, images), opts["title"], opts["density"])
    except Refused as e:
        print(f"image-page: {e}", file=sys.stderr)
        return 1
    try:
        warnings = write_page(out, state, stale, images, page)
    except (PageLost, OSError) as e:
        print(f"image-page: {write_error(out, e)}", file=sys.stderr)
        return 3
    for warning in warnings:
        print(f"image-page: {warning}", file=sys.stderr)
    print(os.path.abspath(os.path.join(out, INDEX)))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
