#!/usr/bin/env bash
# agent-env: start an agent harness with the secrets its list declares, read
# fresh from ~/.bashrc.secrets at this start, and without the others.
#
# usage: agent-env <harness> <command> [arg ...]
#
# A shell keeps the values ~/.bashrc.secrets held when it started, so a
# harness started from an older shell would miss a token added since. This
# script sources the file itself, in its own process, each time:
#   - ~/.config/agent-env/<harness> lists the names the harness gets, one per
#     line; "#" starts a comment, blank lines are skipped. A missing list, a
#     harness name other than letters, digits, ".", "_" and "-" (not starting
#     with "."), or a line that is no variable name stops the start.
#   - ~/.bashrc.secrets is sourced with xtrace and verbose off, so `bash -x`
#     shows none of it. Without the file the command starts without it, after
#     one line on stderr.
#   - Every name the file assigns (a line `NAME=...` or `export NAME=...`)
#     that the list does not declare is unset, a value the calling shell held
#     included. Each declared name with a value is exported; one without a
#     value is named in one line on stderr and not passed.
#   - <command> then replaces this process, with its arguments as given; its
#     exit code is the script's.
# Values are never printed and never put in an argument list.
#
# Exit codes: 2 for a usage error, 1 for a missing or broken list, otherwise
# those of <command> (127 when it is not found).
set -u

if [ $# -lt 2 ]; then
  echo "usage: agent-env <harness> <command> [arg ...]" >&2
  exit 2
fi
harness=$1
shift
if ! [[ $harness =~ ^[A-Za-z0-9_-][A-Za-z0-9._-]*$ ]]; then
  printf 'agent-env: no harness name: %q (letters, digits, ".", "_" and "-", not starting with ".")\n' \
    "$harness" >&2
  exit 2
fi

list=$HOME/.config/agent-env/$harness
if ! [ -f "$list" ] || ! [ -r "$list" ]; then
  echo "agent-env: no list of secrets for $harness: $list" >&2
  exit 1
fi
# The variables that must outlast the sourcing below carry the _agent_env_
# prefix, so an assignment in the secrets file does not overwrite them.
_agent_env_declared=()
n=0
while IFS= read -r line || [ -n "$line" ]; do
  n=$((n + 1))
  line=${line%%#*}
  line=${line#"${line%%[![:space:]]*}"}
  line=${line%"${line##*[![:space:]]}"}
  [ -n "$line" ] || continue
  # A checked name also keeps ${!name} below from evaluating a subscript.
  if ! [[ $line =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    printf 'agent-env: %s line %d is no variable name: %q\n' "$list" "$n" "$line" >&2
    exit 1
  fi
  _agent_env_declared+=("$line")
done <"$list"

_agent_env_secrets=$HOME/.bashrc.secrets
# From here to the restore nothing may be traced: the lines read and the
# values tested hold the secrets.
_agent_env_opts=$-
set +xv
_agent_env_assigned=()
_agent_env_missing=()
_agent_env_found=0
if [ -f "$_agent_env_secrets" ] && [ -r "$_agent_env_secrets" ]; then
  _agent_env_found=1
  while IFS= read -r _agent_env_line || [ -n "$_agent_env_line" ]; do
    if [[ $_agent_env_line =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)= ]]; then
      _agent_env_assigned+=("${BASH_REMATCH[2]}")
    fi
  done <"$_agent_env_secrets"
  unset -v _agent_env_line
  set +u
  # shellcheck source=/dev/null
  . "$_agent_env_secrets"
  set -u
  for _agent_env_name in "${_agent_env_assigned[@]}"; do
    case " ${_agent_env_declared[*]} " in
      *" $_agent_env_name "*) ;;
      *) unset -v "$_agent_env_name" ;;
    esac
  done
fi
for _agent_env_name in "${_agent_env_declared[@]}"; do
  if [ -n "${!_agent_env_name-}" ]; then
    export "${_agent_env_name?}"
  else
    unset -v "$_agent_env_name"
    _agent_env_missing+=("$_agent_env_name")
  fi
done
case $_agent_env_opts in *x*) set -x ;; esac
case $_agent_env_opts in *v*) set -v ;; esac

if [ "$_agent_env_found" = 0 ]; then
  echo "agent-env: no $_agent_env_secrets, starting $1 without it" >&2
else
  for _agent_env_name in "${_agent_env_missing[@]}"; do
    echo "agent-env: $_agent_env_name has no value in $_agent_env_secrets, not passed to $1" >&2
  done
fi
exec "$@"
