#!/usr/bin/env bash
# Caps the TypeScript language server and the tsserver it spawns.
#
# Claude Code starts `typescript-language-server` once per session and keeps
# it for the session's lifetime; over a two-day session on a large project
# its tsserver child grew past 1.3 GB and the machine went into swap. The
# server exposes no memory setting through Claude Code, but both processes
# are node, and node honours NODE_OPTIONS in every child it spawns: with an
# old-space cap the process dies and is restarted by the client instead of
# growing without bound.
#
# The cap applies only to this process tree, never to the shell or to Claude
# Code itself. This directory is put ahead of mise's install paths by
# ~/.bashrc, after `mise activate`, because mise prepends its own paths and
# would otherwise win the lookup.
set -euo pipefail

self_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# Drop this directory from PATH so the lookup below finds the real binary.
real_path=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$self_dir" | paste -sd: -)
real=$(PATH="$real_path" command -v typescript-language-server || true)
if [ -z "$real" ]; then
  echo "typescript-language-server: real binary not found on PATH" >&2
  exit 127
fi

export NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--max-old-space-size=768"
exec "$real" "$@"
