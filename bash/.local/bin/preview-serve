#!/usr/bin/env bash
# Serve a directory of pages or images on this machine's home-network address,
# in the background, and print the link and the server's PID.
#
# usage: preview-serve <dir>
#        preview-serve --stop <pid>
#        preview-serve --addr
#
# The address is the src of `ip -4 route get 1.1.1.1`. The port is the first
# one that nothing listens on (`ss -Hltn`, any address) in the range
# /etc/preview-ports holds as <first>-<last>; the homelab playbook writes that
# file on hosts whose firewall opens only that range to the LAN. When every
# port of the range is taken, nothing starts and the exit code is 1. Without
# the file the range is 8700-8719, the one the playbook writes, and one line on
# stderr says so; a symlink there to a missing file is an error. --addr prints
# that address and port as "<ip> <port>" and starts nothing, for a dev server
# to bind to.
#
# The server hands out every file below <dir> and follows symlinks, so <dir>
# may hold no .git at or below it (a work tree root, a nested clone) and no
# symlink whose target lies outside it.
#
# The server is python3 -I -m http.server, started from / in its own session
# so it imports nothing from the caller's directory and outlives the shell.
# Its output goes to ${XDG_STATE_HOME:-~/.local/state}/preview-serve/<port>.log
# and its PID to <port>.pid beside it. The link is printed once ss shows the
# server listening. A server that exits first lost its port to another
# process after the check: the next free port is tried, 3 in all. One that
# does not listen within 3 seconds is stopped. --stop ends only a server with
# such a PID file whose command line still matches it, and removes the file.
#
# PREVIEW_PORTS_FILE overrides the path of the range file.
set -euo pipefail
# die inside $(...) must end the script, not just the substitution's subshell.
shopt -s inherit_errexit

ports_file=${PREVIEW_PORTS_FILE:-/etc/preview-ports}
# The range the homelab playbook writes on the Minisforum, the one known source.
fallback_range=8700-8719
listen_wait=3
start_tries=3
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/preview-serve

die() {
  printf 'preview-serve: %s\n' "$*" >&2
  exit 1
}
usage() {
  echo "usage: preview-serve <dir> | preview-serve --stop <pid> | preview-serve --addr" >&2
  exit 2
}

# stop <pid>: ends the server whose PID file names <pid>, once its command
# line shows the PID still belongs to that server, and removes the file. A
# file whose server is gone is removed too.
stop() {
  local pid=$1 file='' candidate port cmdline
  [[ $pid =~ ^[0-9]+$ ]] || die "not a PID: $pid"
  for candidate in "$state_dir"/*.pid; do
    if [ -f "$candidate" ] && [ "$(<"$candidate")" = "$pid" ]; then
      file=$candidate
      break
    fi
  done
  [ -n "$file" ] || die "no server started by preview-serve has PID $pid"
  port=${file##*/}
  port=${port%.pid}
  if ! cmdline=$(tr '\0' ' ' 2>/dev/null <"/proc/$pid/cmdline") ||
    [[ $cmdline != *" -m http.server $port "* ]]; then
    rm -f -- "$file"
    die "the server on port $port with PID $pid is gone; its PID file is removed"
  fi
  kill -- "$pid"
  rm -f -- "$file"
  echo "stopped $pid"
}

# load_range: sets $first and $last from the range file, or from the
# fallback with one line on stderr when there is no file. Run it outside a
# command substitution, so the globals and that line come once per run.
load_range() {
  local range
  if [ -e "$ports_file" ]; then
    range=$(<"$ports_file") || die "cannot read $ports_file"
  elif [ -L "$ports_file" ]; then
    die "$ports_file is a symlink to a missing file"
  else
    range=$fallback_range
    printf 'preview-serve: no %s, so the range is %s\n' "$ports_file" "$range" >&2
  fi
  [[ $range =~ ^([0-9]{1,5})-([0-9]{1,5})$ ]] ||
    die "$ports_file holds no <first>-<last> port range: $range"
  first=$((10#${BASH_REMATCH[1]}))
  last=$((10#${BASH_REMATCH[2]}))
  [ "$first" -ge 1 ] && [ "$first" -le "$last" ] && [ "$last" -le 65535 ] ||
    die "$ports_file holds no valid port range: $range"
}

# Prints the local address:port of every listening TCP socket, one per line.
listening() {
  local sockets addr
  sockets=$(ss -Hltn) || die "ss cannot list the listening ports"
  while read -r _ _ _ addr _; do
    [ -z "$addr" ] || echo "$addr"
  done <<<"$sockets"
}

# free_port [from]: the first port of the range load_range set, from <from>
# on, that nothing listens on, on any address.
free_port() {
  local start sockets addr port
  start=${1:-$first}
  [ "$start" -ge "$first" ] || start=$first
  sockets=$(listening)
  local -A taken=()
  while read -r addr; do
    [ -z "$addr" ] || taken[${addr##*:}]=1
  done <<<"$sockets"
  for ((port = start; port <= last; port++)); do
    if [ -z "${taken[$port]+set}" ]; then
      echo "$port"
      return
    fi
  done
  die "every port of $first-$last is in use; stop a server with preview-serve --stop <pid>"
}

home_ip() {
  local route
  route=$(ip -4 route get 1.1.1.1) || die "no IPv4 route to find the home-network address"
  [[ $route =~ (^|[[:space:]])src[[:space:]]+([0-9.]+) ]] || die "no src address in: $route"
  echo "${BASH_REMATCH[2]}"
}

# check_tree <dir>: refuses a tree the server would hand out more than the
# files to show from: a symlink whose target lies outside <dir>, or a .git at
# or below it. A search that cannot finish refuses too.
check_tree() {
  local dir=$1 escape git
  # shellcheck disable=SC2016 # expanded by the inner bash, once per link
  escape=$(find "$dir" -type l -exec bash -c '
    for link; do
      target=$(readlink -m -- "$link")
      case $target in "$0" | "$0"/*) ;; *) printf "%s -> %s\n" "$link" "$target"; exit 0 ;; esac
    done' "$dir" {} +) || die "cannot check the symlinks below $dir"
  [ -z "$escape" ] || die "a symlink leads outside $dir: ${escape%%$'\n'*}"
  git=$(find -L "$dir" -name .git -print -quit) || die "cannot search $dir for .git"
  [ -z "$git" ] || die "$dir holds $git; serve a directory with only the files to show"
}

# await_listen <pid> <ip> <port> <log>: returns once the server listens on
# <ip>:<port>, fails when it exits before that; a server still not listening
# after $listen_wait seconds is stopped and the script dies with its output.
await_listen() {
  local pid=$1 address=$2:$3 log=$4 deadline=$((SECONDS + listen_wait)) sockets
  while kill -0 "$pid" 2>/dev/null; do
    sockets=$(listening)
    if grep -qxF -- "$address" <<<"$sockets"; then
      return 0
    fi
    if [ "$SECONDS" -ge "$deadline" ]; then
      kill -- "-$pid" 2>/dev/null || true
      cat "$log" >&2
      die "the server did not listen on $address within $listen_wait s; its output is above"
    fi
    sleep 0.1
  done
  return 1
}

serve() {
  local dir ip port log pid tries=0 from=
  [ -d "$1" ] || die "no such directory: $1"
  dir=$(cd "$1" && pwd -P)
  check_tree "$dir"
  ip=$(home_ip)
  load_range
  mkdir -p "$state_dir"
  # -I and the neutral working directory keep python from importing modules
  # planted in the caller's directory or named by PYTHON* variables.
  cd /
  # A port taken between the check and the bind ends the server at once; the
  # next free port is tried then, up to $start_tries ports in all.
  while :; do
    port=$(free_port "$from")
    log=$state_dir/$port.log
    setsid python3 -I -m http.server "$port" --bind "$ip" --directory "$dir" </dev/null >"$log" 2>&1 &
    pid=$!
    if await_listen "$pid" "$ip" "$port" "$log"; then
      break
    fi
    tries=$((tries + 1))
    if [ "$tries" -ge "$start_tries" ]; then
      cat "$log" >&2
      die "the server exited at once on $tries ports, the last $port; its output is above"
    fi
    from=$((port + 1))
  done
  echo "$pid" >"$state_dir/$port.pid"
  echo "http://$ip:$port/"
  echo "pid $pid; stop it with: preview-serve --stop $pid"
}

# Prints "<ip> <port>": what serve would bind to now.
addr() {
  local ip port
  ip=$(home_ip)
  load_range
  port=$(free_port)
  echo "$ip $port"
}

case ${1:-} in
  --addr)
    [ $# -eq 1 ] || usage
    addr
    ;;
  --stop)
    [ $# -eq 2 ] || usage
    stop "$2"
    ;;
  "" | -*) usage ;;
  *)
    [ $# -eq 1 ] || usage
    serve "$1"
    ;;
esac
