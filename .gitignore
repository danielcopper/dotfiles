.worktrees/

# Untracked secrets file sourced from bash/.bashrc — never commit it.
.bashrc.secrets

# Per-package secrets and local-only Claude settings inside any stow package.
# Defensive: catches future packages too, not just the current ones.
**/.env
**/.claude/settings.local.json

# Under herdr-app/.config/herdr-app git tracks only what is whitelisted here; a
# new mod, theme or layout needs its own `!` line.
/herdr-app/.config/herdr-app/*
!/herdr-app/.config/herdr-app/keys.json
!/herdr-app/.config/herdr-app/settings.json
!/herdr-app/.config/herdr-app/mods/
/herdr-app/.config/herdr-app/mods/*
!/herdr-app/.config/herdr-app/mods/leader/
!/herdr-app/.config/herdr-app/mods/focus-history/
!/herdr-app/.config/herdr-app/mods/file-popup/
!/herdr-app/.config/herdr-app/mods/board/
!/herdr-app/.config/herdr-app/mods/board-button/
/herdr-app/.config/herdr-app/mods/*/gpui-kit.d.ts
/herdr-app/.config/herdr-app/mods/*/jsconfig.json
/herdr-app/.config/herdr-app/mods/*/.*
!/herdr-app/.config/herdr-app/themes/
/herdr-app/.config/herdr-app/themes/*
!/herdr-app/.config/herdr-app/themes/catppuccin-mocha.json
!/herdr-app/.config/herdr-app/layouts/
/herdr-app/.config/herdr-app/layouts/*
!/herdr-app/.config/herdr-app/layouts/personal.json
